+inline bool is_pow2(uint32_t n) noexcept {
+    return n != 0 && (n & (n - 1)) == 0;
+}
+
+// 向上取整到 2 的幂 (n <= 2^31; 调用方需先做范围校验)
+inline uint32_t next_pow2(uint32_t n) noexcept {
+    if (n <= 1) return 1;
+    --n;
+    n |= n >> 1;  n |= n >> 2;  n |= n >> 4;
+    n |= n >> 8;  n |= n >> 16;
+    return n + 1;
+}
+
+// 索引探测的第 i 个 bucket。
