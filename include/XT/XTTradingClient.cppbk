#include "XTTradingClient.hbk"

XTTradingClient::XTTradingClient(const char *accessKey,const char *secretKey,const char *accountId,
                const char *ip, const int port) {
    strcpy(_accessKey, accessKey);
    strcpy(_secretKey, secretKey);
    strcpy(_accountId, accountId);
    smc = new sm::SecurityManager(ip, port);
}

XTTradingClient::~XTTradingClient(){

}
bool XTTradingClient::get_spot_balance(vector<Balance> &vec) {
    //{"code":200,"data":{"usdt":{"available":"100.8","freeze":"0"}},"info":"Success"}
//        printf("%s,%d\n",__FUNCTION__ ,__LINE__);
    string url = SPLICE("/trade/api/v1/getBalance?");
    std::map<std::string, std::string> params;
    params["accesskey"] = this->_accessKey;
    params["nonce"] = to_string(crypto::getCurrentTimeMilli());
    string signature = get_signature(params);
    params["signature"] = signature;
    string response = Rest::perform_get((url + param_to_url(params)).c_str());
    Document d;
    Value &res = d.Parse<kParseNumbersAsStringsFlag>(response.c_str());
//            vector<Balance> vec;
    if (res.IsObject() && res.HasMember("code") && crypto::str_cmp(res["code"].GetString(), "200") == true) {
        Value &data = res["data"];
        for (Value::ConstMemberIterator it = data.MemberBegin(); it != data.MemberEnd(); ++it) {
            Balance balance;
//            strcpy(balance.exchId, "XT");
            balance.exchangeTypeEnum = XT;
            strcpy(balance.accountId, this->_accountId);
            strcpy(balance.currency, crypto::to_upper(it->name.GetString()).c_str());
            balance.available = stod(it->value["available"].GetString());
            balance.frozen = stod(it->value["freeze"].GetString());
            balance.updateTime = crypto::getCurrentTime();
            vec.push_back(balance);
        }
        return true;
    }
    return false;
}

bool XTTradingClient::get_order(char *instId, char *orderId, Order &order){
    string instIdStr(instId);
    string orderIdStr(orderId);
    return get_order(instIdStr, orderIdStr, order);
}

bool XTTradingClient::get_order(string &instId, string &orderId, Order &order) {
    //{"code":404,"data":null,"info":"The order does not exist."}
    //{"code":200,"data":{"number":"0.123457","price":"10.12","avgPrice":"0","id":"6879633034128877568",
    // "time":1640232333000,"type":1,"status":1,"completeNumber":"0","completeMoney":"0","entrustType":0},
    // "info":"Success."}
//            printf("%s,%d\n",__FUNCTION__ ,__LINE__);
    string url = SPLICE("/trade/api/v1/getOrder?");
    std::map<std::string, std::string> params;
    params["accesskey"] = this->_accessKey;
    params["nonce"] = to_string(crypto::getCurrentTimeMilli());
    params["market"] = crypto::to_lower(instId);
    params["id"] = string(orderId);
    string signature = get_signature(params);
    params["signature"] = signature;
    string response = Rest::perform_get((url + param_to_url(params)).c_str());
//            cout << response << endl;
//            Order order;
    order.exchangeTypeEnum = XT;
    strcpy(order.instId, instId.c_str());
    strcpy(order.accountId, this->_accountId);
    strcpy(order.orderId, orderId.c_str());
    Document d;
    Value &res = d.Parse<kParseNumbersAsStringsFlag>(response.c_str());

    if(res.IsObject() && res.HasMember("code") ) {
        if(crypto::str_cmp(res["code"].GetString(), "200") == true){
            Value &data = res["data"];
            if(crypto::str_cmp(data["type"].GetString(), "1") == true ){
                order.direction = LONG;
            }
            else{
                order.direction = SHORT;
            }
            if(crypto::str_cmp(data["entrustType"].GetString(), "1") == true ){
                order.orderType = MARKET;
            }
            else{
                order.orderType = LIMIT;
            }

            if(crypto::str_cmp(data["status"].GetString(),"0") == true ){
                order.orderStatus = SUBMITTED;
            }
            else if(crypto::str_cmp(data["status"].GetString(),"1") == true ){
                order.orderStatus = PARTIAL;
            }
            else if(crypto::str_cmp(data["status"].GetString(),"2") == true ){
                order.orderStatus = COMPLETE;
            }
            else if(crypto::str_cmp(data["status"].GetString(),"3") == true ){
                order.orderStatus = CANCELLED;
            }
            else{
                order.orderStatus = UNKNOWN;
            }
            order.volumeTotal = stod(data["number"].GetString());
            order.volumeTraded = stod(data["completeNumber"].GetString());
            order.limitPrice = stod(data["price"].GetString());
            order.updateTime = stol(data["time"].GetString());
            if(data.HasMember("fee")){
//                order.tradeFee = stod(data["fee"].GetString());
            }
            order.ErrorID = stoi(res["code"].GetString());
//                    snprintf(order.msg,res["info"].GetStringLength(), res["info"].GetString() );
        }
        else{
            order.ErrorID = stoi(res["code"].GetString());
            LOG_ERROR("%s", response.c_str());
//                    snprintf(order.msg,res["info"].GetStringLength(), res["info"].GetString() );
        }
        return true;
    }
    else{
        return false;
    }
    order.ErrorID = ERROR_NoError;
    return true;
}

bool XTTradingClient::get_batch_orders(char *instId, vector<string> &orderIdVec, vector<Order> &orderVec){
    string instIdStr(instId);
    return get_batch_orders(instIdStr, orderIdVec, orderVec);
}

bool XTTradingClient::get_batch_orders(string &instId, vector<string> &orderIdVec, vector<Order> &orderVec) {
    //{"code":404,"data":null,"info":"The order does not exist."}
    //{"code":200,"data":{"number":"0.123457","price":"10.12","avgPrice":"0","id":"6879633034128877568",
    // "time":1640232333000,"type":1,"status":1,"completeNumber":"0","completeMoney":"0","entrustType":0},
    // "info":"Success."}
//            printf("%s,%d\n",__FUNCTION__ ,__LINE__);
    string url = SPLICE("/trade/api/v1/getBatchOrders?");
    std::map<std::string, std::string> params;
    params["accesskey"] = this->_accessKey;
    params["nonce"] = to_string(crypto::getCurrentTimeMilli());
    params["market"] = crypto::to_lower(instId);
    if(orderIdVec.size() == 0){
        return true;
    }
    string array("[");
    for(int i = 0;i < orderIdVec.size(); i++){
        array.append(orderIdVec[i]);
        if(i != orderIdVec.size() - 1){
            array.append(",");
        }
    }
    array.append("]");
    string base64Data = base64::encode_from_string(array);
    params["data"] = base64Data;
    string signature = get_signature(params);
    params["signature"] = signature;
    string response = Rest::perform_get((url + param_to_url(params)).c_str());
    cout << response << endl;
//
    Document d;
    Value &res = d.Parse<kParseNumbersAsStringsFlag>(response.c_str());
    if(res.IsObject() && res.HasMember("code") ) {
        if(crypto::str_cmp(res["code"].GetString(), "200") == true){
            Value &data = res["data"];
            for(int i=0; i < data.Size(); i++){
                Order order;
                order.exchangeTypeEnum = XT;
                strcpy(order.instId, instId.c_str());
                strcpy(order.accountId, this->_accountId);
                strcpy(order.orderId, data[i]["id"].GetString());
                if(crypto::str_cmp(data[i]["type"].GetString(), "1") == true ){
                    order.direction = LONG;
                }
                else{
                    order.direction = SHORT;
                }
                if(crypto::str_cmp(data[i]["entrustType"].GetString(), "1") == true ){
                    order.orderType = MARKET;
                }
                else{
                    order.orderType = LIMIT;
                }

                if(crypto::str_cmp(data[i]["status"].GetString(),"0") == true ){
                    order.orderStatus = SUBMITTED;
                }
                else if(crypto::str_cmp(data[i]["status"].GetString(),"1") == true ){
                    order.orderStatus = PARTIAL;
                }
                else if(crypto::str_cmp(data[i]["status"].GetString(),"2") == true ){
                    order.orderStatus = COMPLETE;
                }
                else if(crypto::str_cmp(data[i]["status"].GetString(),"3") == true ){
                    order.orderStatus = CANCELLED;
                }
                else{
                    order.orderStatus = UNKNOWN;
                }
                order.volumeTotal = stod(data[i]["number"].GetString());
                order.volumeTraded = stod(data[i]["completeNumber"].GetString());
                order.limitPrice = stod(data[i]["price"].GetString());
                order.updateTime = stol(data[i]["time"].GetString());
                if(data[i].HasMember("fee")){
//                    order.tradeFee = stod(data[i]["fee"].GetString());
                }
                orderVec.push_back(order);
            }
            return true;
        }
        else{
            return false;
//                    order.code = stoi(res["code"].GetString());
//                    snprintf(order.msg,res["info"].GetStringLength(), res["info"].GetString() );
        }

    }
    else{
        return false;
    }
}

bool XTTradingClient::get_open_orders(char *instId, vector<Order> &orderVec){
    string instIdStr(instId);
    return get_open_orders(instIdStr, orderVec);
}

bool XTTradingClient::get_open_orders(string &instId, vector<Order> &orderVec){
    string url = SPLICE("/trade/api/v1/getOpenOrders?");
    std::map<std::string, std::string> params;
    params["accesskey"] = this->_accessKey;
    params["nonce"] = to_string(crypto::getCurrentTimeMilli());
    params["market"] = crypto::to_lower(instId);
    params["page"] = to_string(1);
    params["pageSize"] = to_string(1000);
    string signature = get_signature(params);
    params["signature"] = signature;
    string response = Rest::perform_get((url + param_to_url(params)).c_str());
//            cout << response << endl;

    Document d;
    Value &res = d.Parse<kParseNumbersAsStringsFlag>(response.c_str());
    if(res.IsObject() && res.HasMember("code") ) {
        if (crypto::str_cmp(res["code"].GetString(), "200") == true) {
            Value &data = res["data"];
            for(int i = 0; i < data.Size(); i++){
                Order order;
                order.exchangeTypeEnum = XT;
                strcpy(order.instId, instId.c_str());
                strcpy(order.accountId, this->_accountId);
                strcpy(order.orderId, data[i]["id"].GetString());
                if(crypto::str_cmp(data[i]["type"].GetString(), "1") == true ){
                    order.direction = LONG;
                }
                else{
                    order.direction = SHORT;
                }
                if(crypto::str_cmp(data[i]["entrustType"].GetString(), "1") == true ){
                    order.orderType = MARKET;
                }
                else{
                    order.orderType = LIMIT;
                }

                if(crypto::str_cmp(data[i]["status"].GetString(),"0") == true ){
                    order.orderStatus = SUBMITTED;
                }
                else if(crypto::str_cmp(data[i]["status"].GetString(),"1") == true ){
                    order.orderStatus = PARTIAL;
                }
                else if(crypto::str_cmp(data[i]["status"].GetString(),"2") == true ){
                    order.orderStatus = COMPLETE;
                }
                else if(crypto::str_cmp(data[i]["status"].GetString(),"3") == true ){
                    order.orderStatus = CANCELLED;
                }
                else{
                    order.orderStatus = UNKNOWN;
                }
                order.volumeTotal = stod(data[i]["number"].GetString());
                order.volumeTraded = stod(data[i]["completeNumber"].GetString());
                order.limitPrice = stod(data[i]["price"].GetString());
                order.updateTime = stol(data[i]["time"].GetString());
                if(data[i].HasMember("fee")){
//                    order.tradeFee = stod(data[i]["fee"].GetString());
                }
                orderVec.push_back(order);
            }
            return true;
        }
    }
    return false;
}

bool XTTradingClient::add_new_order(om::Order &order) {
    md::InstrumentInfo info;
    if (smc->get_instrument_info("XT", "SPOT", order.instId, info) == true) {
        string url = SPLICE("/trade/api/v1/order");
        std::map<std::string, std::string> params;
        params["accesskey"] = this->_accessKey;
        params["nonce"] = to_string(crypto::getCurrentTimeMilli());
//                strcpy(order.instId,crypto::to_lower(info.originInstId).c_str());
//                params["market"] = crypto::to_lower(order.instId);// map.put("market", "btc_usdt");
        params["market"] = crypto::to_lower(info.originInstId);
        params["number"] = crypto::getFixedPrecision(order.volumeTotal, info.lotSize);//to_string(order.volumeTotal);
        params["price"] = crypto::getFixedPrecision(order.limitPrice, info.tickSize);

        if (order.direction == LONG) {// open long
            params["type"] = "1";
        } else {
            params["type"] = "0";//open short
        }
        if (order.orderType == LIMIT) {// 0.Limited price  1.Market price matching
            params["entrustType"] = "0";
        } else if (order.orderType == MARKET) {
            params["entrustType"] = "1";
        } else {
            cryptothrow("xt not support now", -1);
        }
        string signature = get_signature(params);
        params["signature"] = signature;
        string paramStr = param_to_url(params);
        string response = Rest::perform_post(url.c_str(), paramStr.c_str());

#ifdef PRINT_DEBUG
        LOG_INFO("url:%s,param:%s,response:%s",url.c_str(), paramStr.c_str(),response.c_str());
#endif
        Document d;
        Value &res = d.Parse<kParseNumbersAsStringsFlag>(response.c_str());
        if (res.IsObject()) {
            if (crypto::str_cmp(res["code"].GetString(), "200")) {
                //{"code":200,"data":{"id":"6879295966433470464"},"info":"Success."}
                Value &data = res["data"];
                strcpy(order.orderId, data["id"].GetString());
                order.ErrorID = ERROR_NoError;
//                        strcpy(order.msg, res["info"].GetString());
                return true;
            } else {//TODO
                //{"code":500,"msg":"price scale error","msgInfo":
                // {"template":"price scale error","args":null,"code":null},"data":{}}
                order.ErrorID = stoi(res["code"].GetString());
                LOG_ERROR("%s", response.c_str());
                return false;
            }

        } else {
            order.ErrorID = ERROR_NotJsonObject;
//                    strcpy(order.msg, response.c_str());
            LOG_ERROR("%s", response.c_str());
            return false;
        }
    }
    else{
        cryptothrow("not found XT.SPOT." + string(order.instId) + " smc info",-1);
        return false;
    }
}

bool XTTradingClient::cancel_order(Order &order) {
    //{"code":200,"data":{"id":"6879295966433470464"},"info":"Success."}
    md::InstrumentInfo info;
    if (smc->get_instrument_info("XT", "SPOT", order.instId, info) == true) {
        string url = SPLICE("/trade/api/v1/cancel");
        std::map<std::string, std::string> params;
        params["accesskey"] = this->_accessKey;
        params["nonce"] = to_string(crypto::getCurrentTimeMilli());
        params["market"] = crypto::to_lower(info.originInstId);//crypto::to_lower(order.instId);// map.put("market", "btc_usdt");
        params["id"] = string(order.orderId);
        string signature = get_signature(params);
        params["signature"] = signature;
        string paramStr = param_to_url(params);
        string response = Rest::perform_post(url.c_str(), paramStr.c_str());
//            cout << response << endl;
        LOG_INFO("%s",response.c_str());
        return true;
    }
    else{
        cryptothrow("not found XT.SPOT." + string(order.instId) + " smc info",-1);
        return false;
    }

}

bool XTTradingClient::batch_cancel_orders(char *instId, vector<string> &orderIdVec){
    string instIdStr(instId);
    return batch_cancel_orders(instIdStr, orderIdVec);
}

bool XTTradingClient::batch_cancel_orders(string &instId, vector<string> &orderIdVec) {
    string url = SPLICE("/trade/api/v1/batchCancel");
    std::map<std::string, std::string> params;
    params["accesskey"] = this->_accessKey;
    params["nonce"] = to_string(crypto::getCurrentTimeMilli());
    params["market"] = instId;// map.put("market", "btc_usdt");
    if(orderIdVec.size() == 0){
        return true;
    }
    string array("[");
    for(int i = 0;i < orderIdVec.size(); i++){
        array.append(orderIdVec[i]);
        if(i != orderIdVec.size() - 1){
            array.append(",");
        }
    }
    array.append("]");
    string base64Data = base64::encode_from_string(array);
    params["data"] = base64Data;
    string signature = get_signature(params);
    params["signature"] = signature;
    string paramStr = param_to_url(params);
    string response = Rest::perform_post(url.c_str(), paramStr.c_str());
//            cout << response << endl;
    return true;
}


std::string XTTradingClient::get_signature(std::map<std::string, std::string> params) {
//        CURL *curl = curl_easy_init();
    string spliceStr;
    for (auto iter = params.begin(); iter != params.end(); ++iter) {
        spliceStr.append(iter->first).append("=").append(iter->second);
        if (iter != --params.end()) {
            spliceStr.append("&");
        }
    }
//        cout << this->_secretKey << endl;
//        cout << spliceStr << endl;
    std::string hmacsha256hex = hmac<sha256>::calc_hex(spliceStr, this->_secretKey);
    return hmacsha256hex;
}

string XTTradingClient::param_to_url(std::map<std::string, std::string> params) {
    string spliceStr;
    for (auto iter = params.begin(); iter != params.end(); ++iter) {
        spliceStr.append(iter->first).append("=").append(iter->second);
        if (iter != --params.end()) {
            spliceStr.append("&");
        }
    }
    return spliceStr;
}
