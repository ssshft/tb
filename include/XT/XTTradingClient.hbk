#define SPLICE(x) "https://" XT_HOST x
//#define XTApiBase "https://api.xt.com"


using namespace cryptlite;
using namespace om;
using namespace md;
using namespace rapidjson;
using namespace std;

class XTTradingClient{
protected:
    char _accessKey[128];
    char _secretKey[128];
    char _accountId[128];
    sm::SecurityManager *smc;
public:
    XTTradingClient(const char *accessKey,const char *secretKey,const char *accountId,
                    const char *ip, const int port);
    virtual ~XTTradingClient();
    bool get_spot_balance(vector<Balance> &vec);
    bool get_order(char *instId, char *orderId, Order &order);
    bool get_order(string &instId, string &orderId, Order &order);
    bool get_batch_orders(char *instId, vector<string> &orderIdVec, vector<Order> &orderVec);
    bool get_batch_orders(string &instId, vector<string> &orderIdVec,
                                 vector<Order> &orderVec);
    bool get_open_orders(char *instId, vector<Order> &orderVec);
    bool get_open_orders(string &instId, vector<Order> &orderVec);

    bool add_new_order(om::Order &order);
    bool cancel_order(Order &order);

    bool batch_cancel_orders(char *instId, vector<string> &orderIdVec);
    bool batch_cancel_orders(string &instId, vector<string> &orderIdVec);


private:
    std::string get_signature(std::map<std::string, std::string> params);
    string param_to_url(std::map<std::string, std::string> params);
};

#endif //TB_XTTRADINGCLIENT_H
